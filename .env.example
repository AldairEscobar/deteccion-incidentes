# ---------------------------------------------------------------------------
# Cliente detector
# ---------------------------------------------------------------------------
INCIDENTES_CLIENT_ID=camara-01
INCIDENTES_LOCATION_ADDRESS=Sin dirección configurada
INCIDENTES_LOCATION_LAT=
INCIDENTES_LOCATION_LON=

# Central REST
INCIDENTES_CENTRAL_URL=http://localhost:8000
INCIDENTES_CENTRAL_API_KEY=
INCIDENTES_ALERTS_ENABLED=true
INCIDENTES_ALERT_ONCE=true
INCIDENTES_ALERT_TIMEOUT=5
INCIDENTES_BEACON_INTERVAL=10

# Verificación con IA local
INCIDENTES_OLLAMA_MODEL=qwen2.5vl:7b
INCIDENTES_OLLAMA_URL=http://localhost:11434

# Detección
INCIDENTES_MODEL_PATH=yolo11n.pt
INCIDENTES_VIOLENCE_MODEL=violence.pt
INCIDENTES_CONFIDENCE=0.5
INCIDENTES_MOTION_THRESHOLD=12
INCIDENTES_PROXIMITY_FACTOR=0.7

# ---------------------------------------------------------------------------
# Central (API REST)
# ---------------------------------------------------------------------------
# Si se define, todas las peticiones deben enviar la cabecera X-API-Key.
CENTRAL_API_KEY=
# Si se define, el despacho se envía por POST a este webhook.
DISPATCH_WEBHOOK_URL=
# Segundos sin latido para considerar caído a un cliente.
CLIENT_ALIVE_SEC=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
